# Copy to rental_3090.env and source it before running phase scripts.

# Python/venv
export PYTHON_BIN=python

# Torch wheel channel for your server CUDA/driver.
# CUDA 12.4 machine: cu124 (recommended default)
# CUDA 12.2 machine: switch to cu121
export TORCH_CUDA_TAG=cu124

# Replace with your real training entrypoint in this repository.
export TRAIN_SCRIPT=src/train_xtts.py

# 3-phase config
export CONFIG=models/VieNeu-TTS/templates/train_config_3phase_rtx3090.yaml

# Output naming
export RUN_TAG=$(date +%Y%m%d_%H%M%S)_3090_phase1
export OUT_DIR=runs/vieneu_tts/${RUN_TAG}/phase1

# GPU/runtime
export CUDA_VISIBLE_DEVICES=0
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128,expandable_segments:True

# Optional extra args forwarded into your train script
export EXTRA_ARGS=""
